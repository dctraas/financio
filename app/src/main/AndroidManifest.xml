<?xml version="1.0" encoding="utf-8"?>
<!--
    Deliberately no android.permission.INTERNET, and no other network permission: fase 1 has no
    backend and no network path for data to leave the device (see the architecture doc's security
    section). Do not add one without first revisiting that decision.

    POST_NOTIFICATIONS below is the one exception, and doesn't touch that boundary: it only lets
    the app show notifications it generates itself, entirely on-device (weekly digest, budget
    threshold), the same way the app already reads its own local database. Required at runtime
    from Android 13 (API 33) onward; a no-op permission before that.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FinancioApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Financio"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Financio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
