<?xml version="1.0" encoding="utf-8"?>
<!--
    Still deliberately no android.permission.INTERNET, and no other network permission: this app
    itself never opens a socket, never talks to a backend, and fase 1 still has no server of its
    own (see the architecture doc's security section). Do not add either without first revisiting
    that decision.

    android:allowBackup below IS that decision, revisited on purpose (see AutoBackupManager's own
    doc comment): Android's own Auto Backup/device-transfer services - a different, system-
    privileged process, not this app - can copy exactly one whitelisted file (backup_rules.xml /
    data_extraction_rules.xml) to the user's own Google account. Never the SQLCipher database
    itself or its AndroidKeystore-wrapped passphrase (DatabasePassphraseProvider): that key is
    hardware-backed and device-bound, so restoring the raw encrypted database file onto a
    different device would leave a database nothing can decrypt. Only a plain, portable JSON
    snapshot - the same format the manual "Volledige back-up exporteren" produces - ever leaves.

    POST_NOTIFICATIONS below is the other exception, and doesn't touch the "no backend" boundary
    at all: it only lets the app show notifications it generates itself, entirely on-device
    (weekly digest, budget threshold), the same way the app already reads its own local database.
    Required at runtime from Android 13 (API 33) onward; a no-op permission before that.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FinancioApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Financio"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Financio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
